---
/** Demo-only "All Astro Themes" card, fixed bottom-right. Rendered only when PUBLIC_STORE_BADGE is set. */
import { STORE } from '../lib/links';
const show = import.meta.env.PUBLIC_STORE_BADGE === 'true';
---
{show && <a class="store t-body-s" href={STORE.href} target="_blank" rel="noreferrer">{STORE.label}</a>}
<style>
  .store {
    position: fixed; right: 20px; bottom: 66px; z-index: 10; min-width: 140px; height: 38px; padding: 0 14px; white-space: nowrap;
    display: flex; align-items: center; justify-content: center; border-radius: 8px;
    background: var(--dark-grey); box-shadow: inset 0 0 0 1px var(--grey-20); color: var(--white); user-select: none;
    transition: background-color 0.4s var(--ease-soft), transform 0.2s var(--ease-out);
  }
  @media (hover: hover) { .store:hover { background: var(--grey); } }
  .store:active { transform: scale(0.96); }
</style>
