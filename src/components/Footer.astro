---
import site from '../content/site.json';
import Button from './ui/Button.astro';
const { cta, footer } = site;
---
<section class="cta" id="cta">
  <div class="cta-stage">
    <div class="particles" data-fx="particle-field" data-src={cta.image} role="img" aria-label={cta.imageAlt}>
      <img class="particle-fallback" src={cta.image} alt="" aria-hidden="true" />
    </div>
  </div>
  <div class="cta-row">
    <h2 class="t-h2 cta-heading"><span class="cta-muted">{cta.headingMuted}</span>{cta.heading}</h2>
    <div class="cta-side">
      <p class="t-body-m">{cta.description}</p>
      <Button href={cta.button.href}>{cta.button.label}</Button>
    </div>
  </div>
</section>
<footer class="footer">
  <div class="footer-rule"></div>
  <div class="main">
    <a class="t-logo wordmark" href="/">
      <img src="/shelter-mark.svg" alt="" width="28" height="28" />
      <span>{site.brand}</span>
    </a>
    <div class="columns">
      {footer.columns.map((col) => (
        <div class="col">
          <p class="t-body-s col-label">{col.label}</p>
          {col.links.map((l) => (
            <p class="t-body-s"><a class="col-link" href={l.href} {...(l.external ? { target: '_blank', rel: 'noreferrer' } : {})}>{l.label}</a></p>
          ))}
        </div>
      ))}
    </div>
  </div>
  <div class="bottom">
    <p class="t-body-s">{footer.copyright}</p>
    <p class="t-body-s">{footer.note}</p>
  </div>
</footer>
<style>
  .cta { width: 100%; max-width: var(--canvas); margin: 0 auto; padding: 100px 0; overflow: clip; display: flex; flex-direction: column; }
  .cta-stage { width: 100%; height: 651px; background: var(--accent-soft); overflow: clip; }
  .particles { position: relative; display: grid; place-items: center; width: 100%; height: 100%; color: var(--accent); }
  .particle-fallback { width: 100%; height: auto; max-height: 100%; object-fit: contain; }
  .particles[data-ready="true"] .particle-fallback { visibility: hidden; }
  .cta-row { display: flex; justify-content: space-between; align-items: flex-end; padding: 20px; }
  .cta-heading { width: 656px; }
  .cta-muted { color: var(--dark-grey); }
  .cta-side { width: 280px; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .cta-side > p, .bottom > p { align-self: stretch; }

  .footer { width: 100%; max-width: var(--canvas); margin: 0 auto; padding: 0 20px 60px; overflow: clip; display: flex; flex-direction: column; }
  .footer-rule { height: 1px; background: var(--grey-20); }
  .main { display: flex; justify-content: space-between; align-items: flex-start; padding-top: 48px; }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; font-size: 20px; }
  .wordmark img { width: 28px; height: 28px; }
  .columns { display: flex; gap: 50px; }
  .col { width: 160px; display: flex; flex-direction: column; gap: 12px; }
  .col-label { color: var(--black); }
  .col-link { color: var(--grey); }
  .bottom { display: flex; justify-content: space-between; align-items: center; padding-top: 64px; }

  @media (max-width: 1199.98px) {
    .cta-stage { height: 543px; }
    .cta-row { flex-direction: column; align-items: flex-start; gap: 32px; }
    .cta-heading, .cta-side { width: 100%; }
    .main { flex-direction: column; gap: 40px; }
    .columns { gap: 32px; }
  }
  @media (max-width: 809.98px) {
    .cta { padding: 64px 0; }
    .cta-stage { height: 280px; }
    .cta-row { gap: 24px; }
    .main { gap: 32px; }
    .columns { gap: 24px; flex-wrap: wrap; row-gap: 24px; }
    .bottom { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
</style>
