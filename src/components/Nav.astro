---
import site from '../content/site.json';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
const { nav } = site;
---
<div class="topbar" data-fx="nav">
  <nav class="nav" aria-label="Main">
    <div class="bar">
      <div class="capsule">
        <a class="t-logo logo" href="/" aria-label="CKB DAO Shelter home">
          <img src="/shelter-mark.svg" alt="" width="28" height="28" />
          <span>{site.brand}</span>
        </a>
        <div class="links desktop-only" aria-hidden="false">
          {nav.links.map((l) => <a class="t-body-m link" href={l.href}>{l.label}</a>)}
        </div>
        <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu" tabindex="-1">
          <Icon name="dots-nine" class="i-open" />
          <Icon name="x" class="i-close" />
        </button>
      </div>
      <div class="buttons desktop-only">
        <Button href={nav.login.href} variant="ghost">{nav.login.label}</Button>
        <Button href={nav.demo.href}>{nav.demo.label}</Button>
      </div>
    </div>
    <div class="menu below-desktop" id="nav-menu" aria-hidden="true" inert>
      <div class="menu-links">
        {nav.links.map((l) => <a class="t-body-m menu-link" href={l.href}>{l.label}</a>)}
      </div>
      <div class="menu-action below-desktop"><Button href={nav.demo.href}>{nav.demo.label}</Button></div>
    </div>
  </nav>
</div>
<style>
  .topbar { position: sticky; top: 0; z-index: 5; width: 100%; max-width: var(--canvas); margin: 0 auto; }
  .nav { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 20px; height: 91px; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .capsule, .buttons { background: rgba(255, 255, 255, 0.88); border: 1px solid var(--grey-20); box-shadow: 0 8px 28px rgba(32, 74, 124, 0.08); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-radius: 16px; }
  .capsule {
    display: flex; align-items: center; justify-content: space-between; gap: 64px; padding: 12px 24px;
  }
  .logo { display: flex; align-items: center; gap: 10px; font-size: 16px; text-align: center; white-space: nowrap; }
  .logo img { width: 28px; height: 28px; }
  .links {
    display: flex; align-items: center; gap: 16px; overflow: hidden; max-width: 480px;
    transition: opacity 0.45s cubic-bezier(0.2, 0.715, 0.205, 0.99), max-width 0.45s cubic-bezier(0.2, 0.715, 0.205, 0.99);
  }
  .link { color: var(--black); white-space: nowrap; user-select: none; }
  .nav-toggle { display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 8px; color: var(--grey); cursor: default; }
  .nav-toggle :global(.i-close) { display: none; }
  .buttons { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 7px; }
  .topbar.is-collapsed .capsule { gap: 36px; }
  .topbar.is-collapsed .links { opacity: 0; max-width: 0; }

  .menu {
    position: absolute; left: 16px; right: 16px; top: 72px; max-height: calc(100vh - 90px); overflow-y: auto;
    display: flex; flex-direction: column; gap: 20px; padding: 16px; z-index: 1;
    background: rgba(255, 255, 255, 0.98); border: 1px solid var(--grey-20); box-shadow: 0 14px 36px rgba(32, 74, 124, 0.12); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-radius: 16px;
    opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 0.2s ease, visibility 0s linear 0.2s;
  }
  .menu-links { display: flex; flex-direction: column; gap: 14px; }
  .menu-link { color: var(--black); }
  .topbar.is-open .menu { opacity: 1; visibility: visible; pointer-events: auto; transition-delay: 0s; }

  @media (max-width: 1199.98px) {
    .nav { padding: 16px; height: 77px; }
    .bar { justify-content: flex-start; }
    .capsule { width: 100%; justify-content: space-between; }
    .nav-toggle { cursor: pointer; }
    .topbar.is-open .menu { opacity: 1; visibility: visible; pointer-events: auto; }
    .topbar.is-open .nav-toggle :global(.i-open) { display: none; }
    .topbar.is-open .nav-toggle :global(.i-close) { display: inline-flex; }
  }
  @media (prefers-reduced-motion: reduce) { .capsule, .links, .menu { transition: none; } }
</style>
