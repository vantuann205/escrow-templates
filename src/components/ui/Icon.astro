---
/** Inline SVG icon from src/icons, coloured with currentColor. */
import check from '../../icons/check.svg?raw';
import dotsNine from '../../icons/dots-nine.svg?raw';
import plus from '../../icons/plus.svg?raw';
import x from '../../icons/x.svg?raw';
import quote from '../../icons/quote.svg?raw';

interface Props { name: 'dots-nine' | 'check' | 'plus' | 'x' | 'quote'; size?: number; class?: string; }
const { name, size = 16, class: cls } = Astro.props;
const icons: Record<string, string> = { check, 'dots-nine': dotsNine, plus, x, quote };
const svg = (icons[name] ?? '').replace('<svg ', `<svg width="${size}" height="${size}" `);
---
<span class:list={['icon', cls]} set:html={svg} />
<style>
  .icon { display: inline-flex; flex: none; }
</style>
