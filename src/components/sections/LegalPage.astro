---
/**
 * Shared layout for /terms and /privacy. Feed it one content file:
 * { eyebrow, title, updated, intro, sections: [{ title, body }] }.
 * Section numbers ("01 — ") are added here, so reordering or adding a section
 * in the JSON renumbers the page by itself.
 */
interface Props {
  content: {
    eyebrow: string;
    title: string;
    updated: string;
    intro: string;
    sections: { title: string; body: string }[];
  };
}
const { content } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="legal-top">
  <div class="legal-title">
    <p class="t-eyebrow">{content.eyebrow}</p>
    <h1 class="t-h1 balance">{content.title}</h1>
  </div>
  <p class="t-body-s updated">{content.updated}</p>
</section>
<section class="legal-body">
  <div class="column">
    <p class="t-body-m">{content.intro}</p>
    {content.sections.map((s, i) => (
      <div class="block">
        <h2 class="t-h4 balance">{pad(i + 1)} — {s.title}</h2>
        <p class="t-body-m">{s.body}</p>
      </div>
    ))}
  </div>
</section>
<style>
  .legal-top, .legal-body {
    width: 100%; max-width: var(--canvas); margin: 0 auto;
    display: flex; flex-direction: column; align-items: center;
  }
  .legal-top { gap: 24px; padding: 100px 20px 0; }
  .legal-title { width: 100%; max-width: 760px; display: flex; flex-direction: column; gap: 24px; }
  .updated { width: 100%; max-width: 760px; }
  .legal-body { padding: 64px 20px 120px; }
  .column { width: 100%; max-width: 760px; display: flex; flex-direction: column; gap: 40px; }
  .block { display: flex; flex-direction: column; gap: 12px; }
  @media (max-width: 809.98px) {
    .legal-top { padding-top: 64px; }
    .legal-body { padding: 48px 20px 80px; }
  }
</style>
