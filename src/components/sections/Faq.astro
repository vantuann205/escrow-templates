---
/**
 * FAQ section: intro (eyebrow, title, "ask" card with a button) and the
 * accordion built from the Framer component "Sections/FAQ Item".
 * Each item is a <details>, so answers open without JS; with JS
 * (src/scripts/fx/faq.js) the open/close plays Framer's animation.
 *
 * Props:
 *   eyebrow   string
 *   title     string (h2)
 *   card      { title: string; text: string; button: { href: string; label: string } }
 *   items     { q: string; a: string }[]
 *   id?       section id, default 'faq'
 *   class?    extra class on the <section>
 *   cardWidth?           desktop width of the ask card, default '319px' (home uses '320px')
 *   tabletContentWidth?  tablet width of the ask card's text block, default '589px'
 *                        (the pricing page quirk, text runs under the card's clip);
 *                        home uses '100%'
 */
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  card: { title: string; text: string; button: { href: string; label: string } };
  items: { q: string; a: string }[];
  id?: string;
  class?: string;
  cardWidth?: string;
  tabletContentWidth?: string;
}
const { eyebrow, title, card, items, id = 'faq', class: cls, cardWidth = '319px', tabletContentWidth = '589px' } = Astro.props;
---
<section class:list={['faq', cls]} id={id} style={`--faq-card-w: ${cardWidth}; --faq-card-content-w-tablet: ${tabletContentWidth};`}>
  <div class="intro">
    <div class="faq-title">
      <p class="t-eyebrow">{eyebrow}</p>
      <h2 class="t-h2 balance">{title}</h2>
    </div>
    <div class="ask">
      <div class="ask-content">
        <h3 class="t-h4">{card.title}</h3>
        <p class="t-body-m ask-text">{card.text}</p>
      </div>
      <Button href={card.button.href}>{card.button.label}</Button>
    </div>
  </div>
  <div class="list" data-fx="faq">
    {items.map((item) => (
      <details class="item">
        <summary class="faq-head">
          <h3 class="q t-h5">{item.q}</h3>
          <span class="faq-toggle" aria-hidden="true">
            <span class="toggle-glow-wrap"><span class="toggle-glow"></span></span>
            <span class="toggle-surface"></span>
            <Icon name="plus" size={16} class="toggle-icon" />
          </span>
        </summary>
        <div class="answer">
          <p class="t-body-m">{item.a}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    width: 100%; max-width: var(--canvas); margin: 0 auto;
    display: flex; align-items: flex-start; gap: 80px; padding: 100px 20px;
  }
  .intro {
    flex: 1 1 0; min-width: 0; height: 631px;
    display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start;
  }
  .faq-title { width: 100%; display: flex; flex-direction: column; gap: 20px; }
  .ask {
    width: var(--faq-card-w); display: flex; flex-direction: column; align-items: flex-start; gap: 16px;
    padding: 32px; border-radius: var(--radius); background: var(--surface); overflow: clip;
  }
  .ask-content { width: 100%; flex: none; display: flex; flex-direction: column; gap: 8px; }
  .ask-text { color: var(--dark-grey); }

  .list { width: 662px; flex: none; display: flex; flex-direction: column; gap: 16px; }
  .item {
    width: 100%; padding: 32px; border-radius: var(--radius); background: var(--surface);
    overflow: clip; cursor: pointer;
  }
  .faq-head { display: flex; align-items: flex-start; gap: 16px; list-style: none; cursor: pointer; }
  .faq-head::-webkit-details-marker { display: none; }
  .faq-head:focus-visible { outline: none; }
  .item:has(.faq-head:focus-visible) { outline: 2px solid var(--grey); outline-offset: 2px; }
  .q { flex: 1 1 0; min-width: 0; }
  .answer { padding-top: 16px; }
  .answer .t-body-m { color: var(--dark-grey); }

  /* Toggle: the Button component's "Icon" variant (white square, plus icon
     that turns 45deg into an x when open, hue-cycling glow on hover). */
  .faq-toggle {
    position: relative; flex: none; width: 32px; height: 32px; padding: 8px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
  }
  .toggle-glow-wrap {
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center;
    padding: 2px 0; transition: padding 0.4s var(--ease-soft);
  }
  .toggle-glow {
    width: 100%; flex: 1; border-radius: 9px; opacity: 0; background: var(--accent);
    box-shadow: 0 3px 10px rgba(33, 102, 197, 0.28);
    transition: opacity 0.4s var(--ease-soft);
  }
  .toggle-surface { position: absolute; inset: 1px; border-radius: 8px; background: var(--white); }
  .faq-toggle :global(.toggle-icon) { position: relative; z-index: 1; color: var(--dark-grey); transition: transform 0.4s var(--ease-soft); }
  .faq-toggle :global(path) { stroke-width: 2; }
  .item[open]:not(.is-closing) .faq-toggle :global(.toggle-icon) { transform: rotate(45deg); }
  @media (hover: hover) {
    .faq-toggle:hover .toggle-glow-wrap { padding: 0; }
    .faq-toggle:hover .toggle-glow { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .toggle-glow-wrap, .toggle-glow, .faq-toggle :global(.toggle-icon) { transition: none; } }

  @media (max-width: 1199.98px) {
    .faq { flex-direction: column; gap: 32px; }
    .intro { width: 100%; flex: none; height: auto; justify-content: flex-start; gap: 40px; }
    .ask { width: 320px; }
    .ask-content { width: var(--faq-card-content-w-tablet); }
    .list { width: 100%; }
  }
  @media (max-width: 809.98px) {
    .faq { padding: 64px 20px; }
    .intro { justify-content: space-between; gap: 0; }
    .ask { width: 100%; }
    .ask-content { width: 100%; }
  }
</style>
