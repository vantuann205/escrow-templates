---
/** Contact page header: eyebrow + h1 on the left, a short blurb bottom-right. */
import contact from '../../content/pages/contact.json';
---
<section class="contact-top">
  <div class="contact-top-row">
    <div class="contact-top-title">
      <p class="t-eyebrow">{contact.eyebrow}</p>
      <h1 class="t-h1 balance">{contact.title}</h1>
    </div>
    <div class="contact-top-description">
      <p class="t-body-m">{contact.blurb}</p>
    </div>
  </div>
</section>
<style>
  .contact-top {
    width: 100%; max-width: var(--canvas); margin: 0 auto;
    display: flex; flex-direction: column; align-items: center; padding: 100px 20px 0;
  }
  .contact-top-row { width: 100%; display: flex; justify-content: space-between; align-items: flex-end; }
  .contact-top-title { flex: 1 0 0; max-width: 700px; display: flex; flex-direction: column; gap: 24px; }
  .contact-top-description { width: 273px; flex: none; }
  @media (max-width: 1199.98px) {
    .contact-top-row { flex-direction: column; align-items: flex-start; gap: 24px; }
    .contact-top-title { flex: none; width: 100%; }
    .contact-top-description { width: 100%; }
  }
  @media (max-width: 809.98px) {
    .contact-top { padding-top: 64px; }
    .contact-top-row { gap: 20px; }
  }
</style>
