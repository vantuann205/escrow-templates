---
import home from '../../content/pages/home.json';
import Plans from './Plans.astro';
const { pricing } = home;
---
<section class="pricing" id="pricing">
  <div class="home-pricing-title">
    <p class="t-eyebrow">{pricing.eyebrow}</p>
    <h2 class="t-h2 balance">{pricing.title}</h2>
  </div>
  <Plans nameTag="h3" />
</section>
<style>
  .pricing { width: 100%; max-width: var(--canvas); margin: 0 auto; padding: 100px 20px; display: flex; flex-direction: column; align-items: center; gap: 80px; }
  .home-pricing-title { width: 700px; display: flex; flex-direction: column; gap: 24px; text-align: center; }
  @media (max-width: 1199.98px) { .home-pricing-title { width: 100%; } }
  @media (max-width: 809.98px) { .pricing { padding: 64px 20px; } }
</style>
