---
/**
 * "Who is here": a list of names beside a row of portrait cards. Picking a name
 * (or a card) opens that card's portrait, moves the star marker, dims the other
 * names and slides the row so the card lands on the left edge
 * (fx/team-switch.js, a port of withTeamSwitch). Without JS the first person is
 * shown selected.
 */
import about from '../../content/pages/about.json';
const { team } = about;
---
<section class="about-team">
  <div class="about-team-title">
    <p class="t-eyebrow">{team.eyebrow}</p>
    <h2 class="t-h2 balance">{team.title}</h2>
  </div>
  <div class="team" data-fx="team-switch">
    <div class="names" role="group" aria-label={team.eyebrow}>
      {team.people.map((p, i) => (
        <button type="button" class:list={['name-row', { 'is-active': i === 0 }]} data-index={i} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span class="marker" aria-hidden="true"></span>
          <span class="t-label about-team-name">{p.name}</span>
        </button>
      ))}
    </div>
    <div class="about-team-viewport">
      <div class="cards" id="about-team-track">
        {team.people.map((p, i) => (
          <div class:list={['about-team-card', { 'is-active': i === 0 }]} data-index={i}>
            <div class="about-team-photo">
              <img src={p.photo.src} alt={p.photo.alt} width="1056" height="1482" loading="lazy" />
            </div>
            <div class="veil" aria-hidden="true">
              <span class="blur blur-1"></span>
              <span class="blur blur-2"></span>
              <span class="blur blur-3"></span>
              <span class="tint"></span>
            </div>
            <div class="meta">
              <p class="t-label">{p.name}</p>
              <p class="t-eyebrow">{p.role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .about-team {
    width: 100%; max-width: var(--canvas); margin: 0 auto;
    display: flex; flex-direction: column; align-items: flex-start; gap: 80px; padding: 100px 20px;
  }
  .about-team-title { width: 472px; display: flex; flex-direction: column; gap: 24px; }
  .team { width: 100%; height: 543px; display: flex; align-items: flex-start; gap: 80px; overflow: clip; }

  .names { width: 240px; flex: none; display: flex; flex-direction: column; align-items: flex-start; }
  .name-row {
    width: 100%; display: flex; align-items: center; gap: 16px; padding: 8px 0; text-align: left;
    cursor: pointer; opacity: 0.45;
  }
  .name-row.is-active { opacity: 1; }
  .about-team-name { flex: 1 0 0; min-width: 0; color: var(--grey); }
  .marker {
    flex: none; width: 16px; height: 16px; opacity: 0;
    background: linear-gradient(90deg, rgb(235, 206, 127) 0%, rgb(205, 32, 202) 52.404%, rgb(195, 32, 35) 100%);
    -webkit-mask: url('/assets/about/star.svg') center / contain no-repeat;
    mask: url('/assets/about/star.svg') center / contain no-repeat;
  }
  .name-row.is-active .marker { opacity: 1; }

  .about-team-viewport { flex: 1 0 0; min-width: 0; height: 100%; display: flex; align-items: center; overflow: clip; }
  .cards { flex: none; height: 100%; display: flex; align-items: center; gap: 8px; }
  .about-team-card {
    position: relative; flex: none; width: 385px; height: 100%; cursor: pointer;
    background: var(--surface); border-radius: 16px; overflow: clip;
  }
  .about-team-photo {
    position: absolute; inset: 0; margin: auto; width: 72.2%; height: 65.7%;
    border-radius: 16px; overflow: clip;
  }
  .about-team-card.is-active .about-team-photo { width: 100%; height: 100%; }
  .about-team-photo img { width: 100%; height: 100%; object-fit: cover; border-radius: 16px; }
  .veil { position: absolute; left: 0; bottom: 0; width: 100%; height: 200px; opacity: 0; pointer-events: none; }
  .about-team-card.is-active .veil { opacity: 1; }
  .veil > span { position: absolute; inset: 0; }
  .blur-1 {
    backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px);
    -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 35%);
    mask-image: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 35%);
  }
  .blur-2 {
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,0) 35%, rgba(0,0,0,1) 70%);
    mask-image: linear-gradient(180deg, rgba(0,0,0,0) 35%, rgba(0,0,0,1) 70%);
  }
  .blur-3 {
    backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
    -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,0) 65%, rgba(0,0,0,1) 100%);
    mask-image: linear-gradient(180deg, rgba(0,0,0,0) 65%, rgba(0,0,0,1) 100%);
  }
  .tint { background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.5) 55%, rgba(0,0,0,0.7) 100%); }
  .meta {
    position: absolute; left: 0; bottom: 32px; width: 100%; padding: 0 32px;
    display: flex; flex-direction: column; align-items: flex-start; gap: 4px;
  }
  .meta > * { width: 100%; }
  .meta .t-label { color: var(--grey); }

  @media (max-width: 1199.98px) {
    .about-team-title { width: 100%; }
    .team { gap: 40px; }
    .about-team-card { width: 300px; }
  }
  @media (max-width: 809.98px) {
    .about-team { gap: 48px; padding: 64px 20px; }
    .team { height: auto; flex-direction: column; gap: 32px; }
    .names { width: 100%; }
    .about-team-viewport { flex: none; width: 100%; height: 460px; }
  }
</style>
