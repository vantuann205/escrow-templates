---
/** /blog hero: eyebrow, heading and blurb, then the featured post card. */
import Button from '../ui/Button.astro';
import Badge from '../blog/Badge.astro';
import PostMeta from '../blog/PostMeta.astro';
import blog from '../../content/pages/blog.json';
import { postUrl, type Post } from '../../lib/blog';

interface Props { featured?: Post; }
const { featured } = Astro.props;
---
<section class="blog-hero">
  <div class="bh-head">
    <div class="bh-title">
      <p class="t-eyebrow">{blog.hero.eyebrow}</p>
      <h1 class="t-h1 balance">{blog.hero.heading}</h1>
    </div>
    <p class="bh-blurb t-body-m">{blog.hero.blurb}</p>
  </div>
  {featured && (
    <article class="bh-featured">
      <div class="bh-content">
        <div class="bh-top">
          <Badge label={featured.data.category} />
          <PostMeta date={featured.data.date} readTime={featured.data.readTime} />
        </div>
        <div class="bh-copy">
          <h2 class="t-h4">{featured.data.title}</h2>
          <p class="t-body-m">{featured.data.excerpt}</p>
          <Button href={postUrl(featured)} variant="primary">{blog.hero.read}</Button>
        </div>
      </div>
      <a class="bh-cover" href={postUrl(featured)} tabindex="-1" aria-hidden="true">
        <img src={featured.data.cover} alt={featured.data.coverAlt} width="752" height="577" fetchpriority="high" />
      </a>
    </article>
  )}
</section>

<style>
  .blog-hero {
    display: flex; flex-direction: column; align-items: center; gap: 80px;
    max-width: var(--canvas); margin: 0 auto; padding: 100px 20px 40px;
  }
  .bh-head { display: flex; justify-content: space-between; align-items: flex-end; width: 100%; }
  .bh-title { display: flex; flex-direction: column; gap: 24px; width: 700px; }
  .bh-blurb { width: 273px; }

  .bh-featured { display: flex; gap: 8px; width: 100%; height: 577px; }
  .bh-content {
    display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start;
    flex: none; width: 400px; padding: 32px; border-radius: 16px; overflow: clip;
    background: var(--surface); -webkit-backdrop-filter: blur(9px); backdrop-filter: blur(9px);
  }
  .bh-top { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; width: 100%; }
  .bh-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; width: 100%; }
  .bh-copy h2, .bh-copy p { width: 100%; }
  .bh-cover { flex: 1 1 0; min-width: 0; height: 100%; border-radius: 16px; overflow: clip; }
  .bh-cover img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 1199.98px) {
    .blog-hero { gap: 48px; }
    .bh-head { flex-direction: column; justify-content: flex-start; align-items: flex-start; gap: 24px; }
    .bh-title, .bh-blurb { width: 100%; }
    .bh-featured { flex-direction: column; height: auto; }
    .bh-content { width: 100%; justify-content: flex-start; gap: 24px; }
    .bh-cover { flex: none; width: 100%; height: 320px; }
  }
  @media (max-width: 809.98px) {
    .blog-hero { gap: 40px; padding: 64px 20px 32px; }
    .bh-head { gap: 20px; }
    .bh-content { padding: 20px; }
    .bh-cover { height: 220px; }
  }
</style>
