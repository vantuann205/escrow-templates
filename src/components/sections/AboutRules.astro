---
/**
 * "Our rules": on Desktop and Tablet the section is 2400px tall and its stage
 * sticks to the top while the four cards climb in one by one and the row slides
 * left to land the last card (fx/rules-scroll.js, a port of withRulesScroll).
 * On Phone it is a plain column. Without JS every card sits at rest.
 */
import about from '../../content/pages/about.json';
const { rules } = about;
---
<section class="about-rules" id="about-rules" data-fx="rules-scroll">
  <div class="about-rules-stage" id="about-rules-stage">
    <div class="about-rules-title">
      <p class="t-eyebrow">{rules.eyebrow}</p>
      <h2 class="t-h2 balance">{rules.title}</h2>
    </div>
    <div class="about-rules-viewport" id="about-rules-viewport">
      <div class="about-rules-track" id="about-rules-track">
        {rules.items.map((r) => (
          <article class="about-rule">
            <div class="copy">
              <p class="t-eyebrow">{r.number}</p>
              <p class="t-label text">{r.text}</p>
            </div>
            <div class="texture">
              <img src={r.texture.src} alt={r.texture.alt} width={r.texture.width} height={r.texture.height} loading="lazy" />
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .about-rules {
    width: 100%; max-width: var(--canvas); margin: 0 auto; height: 2400px;
    display: flex; flex-direction: column; align-items: center;
  }
  .about-rules-stage {
    position: sticky; top: 0; width: 100%; height: 830px; overflow: clip; background: var(--black);
    display: flex; flex-direction: column; align-items: center; gap: 80px; padding: 100px 20px;
  }
  .about-rules-title { width: 100%; max-width: 700px; display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; }
  .about-rules-title > * { width: 100%; }
  .about-rules-viewport { width: 100%; height: 394px; flex: none; overflow: clip; display: flex; align-items: flex-start; }
  .about-rules-track { flex: none; display: flex; align-items: flex-start; gap: 8px; }
  .about-rule {
    flex: none; width: 381px; height: 394px; display: flex; align-items: flex-start;
    background: var(--surface); border-radius: 16px; overflow: clip;
  }
  .copy {
    flex: 1 0 0; min-width: 0; height: 100%; padding: 32px;
    display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start;
  }
  .copy > * { width: 100%; }
  .text { color: var(--white); }
  .texture { flex: none; width: 90px; height: 100%; }
  .texture img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 1199.98px) {
    .about-rule { width: 300px; }
  }
  @media (max-width: 809.98px) {
    .about-rules { height: auto; }
    .about-rules-stage { position: relative; height: auto; gap: 48px; padding: 64px 20px; }
    .about-rules-viewport { height: auto; overflow: visible; }
    .about-rules-track { width: 100%; flex-direction: column; gap: 20px; }
    .about-rule { width: 100%; height: 300px; }
  }
</style>
