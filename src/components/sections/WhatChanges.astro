---
import home from '../../content/pages/home.json';
const { changes } = home;
const [queue, handover, overnight, ninety] = changes.cards;
---
<section class="changes" id="what-changes" data-fx="carousel">
  <div class="changes-stage">
    <div class="title-row">
      <div class="changes-title">
        <p class="t-eyebrow">{changes.eyebrow}</p>
        <h2 class="t-h2 balance">{changes.title}</h2>
      </div>
    </div>
    <div class="changes-viewport" role="region" aria-label="CKB DAO scenario cards" tabindex="0">
      <div class="changes-track">
        {changes.cards.map((card, i) => (
          <article class="changes-card">
            <h3 class="t-h4">{card.title}</h3>
            <div class="scene">
              <img class="scene-bg" src={card.image} alt={card.imageAlt} width="1000" height="681" loading="lazy" draggable="false" />
              {i === 0 && (
                <div class="changes-panel changes-panel--queue">
                  <div class="changes-head"><p class="mono-s grow">{queue.panel.label}</p><p class="mono-s">{queue.panel.status}</p></div>
                  <div class="count">
                    <p class="count-value">{queue.panel.count}</p>
                    <p class="count-compare">{queue.panel.compare}</p>
                  </div>
                  <div class="week" aria-hidden="true">
                    {queue.panel.bars.map((h, d) => <span class:list={['day', { today: d === queue.panel.bars.length - 1 }]} style={`height:${h}px`} />)}
                  </div>
                </div>
              )}
              {i === 1 && (
                <div class="changes-panel changes-panel--handover">
                  <div class="changes-head"><p class="mono-s grow">{handover.panel.label}</p><p class="mono-s">{handover.panel.status}</p></div>
                  <div class="message">
                    <p class="changes-quote">{handover.panel.message}</p>
                    <div class="tags">{handover.panel.tags.map((t) => <span class="pill">{t}</span>)}</div>
                  </div>
                  <div class="route"><p class="mono-m grow">{handover.panel.route}</p><p class="mono-m white">{handover.panel.to}</p></div>
                </div>
              )}
              {i === 2 && (
                <div class="changes-panel changes-panel--overnight">
                  <div class="changes-head"><p class="mono-s grow">{overnight.panel.label}</p><p class="mono-s">{overnight.panel.status}</p></div>
                  <div class="ends"><p class="mono-m">{overnight.panel.start}</p><p class="mono-m">{overnight.panel.end}</p></div>
                  <div class="timeline" aria-hidden="true"><span class="base"></span><span class="elapsed"></span><span class="halo"></span><span class="sent"></span></div>
                  <div class="message message--tight">
                    <p class="changes-quote">{overnight.panel.message}</p>
                    <div class="source"><p class="mono-m grow">{overnight.panel.source}</p><p class="mono-m white">{overnight.panel.time}</p></div>
                  </div>
                </div>
              )}
              {i === 3 && (
                <div class="changes-panel changes-panel--ninety">
                  <div class="changes-head"><p class="mono-s grow">{ninety.panel.label}</p><p class="mono-s">{ninety.panel.status}</p></div>
                  <div class="faces" aria-label="CKB DAO Shelter">
                    <img class="brand-mark" src="/shelter-mark.svg" alt="" width="28" height="28" />
                    <span>CKB DAO Shelter</span>
                  </div>
                  <div class="changes-rows">
                    {ninety.panel.rows.map((r, n) => (
                      <>
                        {n > 0 && <span class="changes-divider" />}
                        <div class="changes-row"><p class="row-label">{r.label}</p><p class="row-value">{r.value}</p></div>
                      </>
                    ))}
                  </div>
                </div>
              )}
            </div>
            <p class="t-body-m changes-desc">{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .changes { width: 100%; display: flex; flex-direction: column; align-items: center; }
  .changes-stage { position: relative; width: 100%; padding: 100px 0; background: var(--page); display: flex; flex-direction: column; align-items: center; gap: 80px; }
  .title-row { width: 100%; max-width: var(--canvas); padding: 0 20px; display: flex; flex-direction: column; align-items: center; }
  .changes-title { width: 700px; display: flex; flex-direction: column; gap: 24px; text-align: center; }
  .changes-viewport { width: 100%; max-width: var(--canvas); padding: 0 20px; margin: 0 auto; overflow-x: auto; overflow-y: hidden; display: flex; scroll-snap-type: x mandatory; scrollbar-width: none; cursor: grab; user-select: none; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; }
  .changes-viewport::-webkit-scrollbar { display: none; }
  .changes-viewport.is-dragging { cursor: grabbing; scroll-snap-type: none; }
  .changes-track { display: flex; width: max-content; gap: 20px; align-items: stretch; flex: none; }
  .changes-card { width: 570px; flex: none; display: flex; flex-direction: column; gap: 20px; padding: 40px; border-radius: 16px; background: var(--surface); overflow: clip; scroll-snap-align: start; scroll-snap-stop: always; }
  .changes-desc { color: var(--dark-grey); align-self: stretch; }
  .scene { position: relative; width: 100%; height: 300px; flex: none; display: flex; align-items: center; justify-content: center; padding: 0 40px; border-radius: 16px; overflow: clip; }
  .scene-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .changes-panel { position: relative; width: 100%; max-width: 380px; display: flex; flex-direction: column; gap: 16px; padding: 24px 26px; border-radius: 16px; background: var(--black); box-shadow: 0 14px 34px -14px rgba(0, 0, 0, 0.55); overflow: clip; }
  .changes-panel--queue { gap: 22px; }
  .changes-panel--ninety { gap: 14px; padding: 20px 26px; }
  .changes-head, .route, .source { display: flex; align-items: center; gap: 12px; }
  .route, .source { gap: 10px; }
  .grow { flex: 1 1 0; min-width: 0; }
  .mono-s { font-family: var(--font-mono); font-size: 11px; line-height: 1.2em; letter-spacing: 0.88px; color: var(--dark-grey); }
  .mono-m { font-family: var(--font-mono); font-size: 12px; line-height: 1.2em; color: var(--dark-grey); }
  .white { color: var(--white); }
  .count { display: flex; flex-direction: column; gap: 6px; }
  .count-value { font-size: 42px; font-weight: 600; line-height: 1.2em; letter-spacing: -2.1px; color: var(--white); }
  .count-compare { font-size: 15px; line-height: 1.2em; color: var(--dark-grey); }
  .week { display: flex; align-items: flex-end; gap: 9px; }
  .day { width: 13px; border-radius: 4px; background: var(--dark-grey); }
  .day.today, .elapsed { background: linear-gradient(90deg, var(--accent), var(--accent-strong)); }
  .message { display: flex; flex-direction: column; gap: 12px; padding: 16px 18px; border-radius: 12px; background: rgb(24, 24, 23); overflow: clip; }
  .message--tight { gap: 10px; }
  .changes-quote { font-size: 15px; font-weight: 500; line-height: 1.2em; color: var(--white); }
  .tags { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .pill { display: inline-flex; padding: 5px 11px; border-radius: 999px; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12); font-family: var(--font-mono); font-size: 10px; line-height: 1.2em; letter-spacing: 0.8px; color: rgb(165, 164, 159); }
  .ends { display: flex; justify-content: space-between; align-items: center; }
  .timeline { position: relative; height: 18px; }
  .timeline > span { position: absolute; border-radius: 999px; }
  .base { left: 0; right: 0; top: 8px; height: 2px; background: rgba(255, 255, 255, 0.12); }
  .elapsed { left: 0; top: 8px; width: 112px; height: 2px; }
  .halo { left: 100px; top: -3px; width: 24px; height: 24px; background: rgba(255, 255, 255, 0.14); }
  .sent { left: 105px; top: 2px; width: 14px; height: 14px; background: var(--white); }
  .faces { display: flex; align-items: center; gap: 8px; min-height: 32px; color: var(--white); font-size: 13px; font-weight: 650; }
  .brand-mark { width: 28px; height: 28px; }
  .changes-rows { display: flex; flex-direction: column; }
  .changes-row { display: flex; align-items: center; gap: 12px; padding: 9px 0; }
  .row-label { flex: 1 1 0; font-size: 15px; line-height: 1.2em; color: rgb(165, 164, 159); }
  .row-value { font-family: var(--font-mono); font-size: 14px; line-height: 1.2em; color: var(--white); }
  .changes-divider { height: 1px; background: rgba(255, 255, 255, 0.07); }

  @media (max-width: 1199.98px) {
    .changes-title { width: 100%; }
    .changes-card { width: 480px; }
  }
  @media (max-width: 809.98px) {
    .changes-stage { height: auto; }
    .changes-card { width: 340px; padding: 20px; }
    .scene { padding: 0 20px; }
    .changes-panel { padding: 20px 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .changes-viewport { scroll-behavior: auto; } }
</style>
