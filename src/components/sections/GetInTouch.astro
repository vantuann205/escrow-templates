---
/**
 * Contact form + aside (email, phone, "What happens next").
 * The form posts to PUBLIC_FORM_ENDPOINT when it is set (see .env.example and
 * src/scripts/fx/contact-form.js); unset, it only plays its states.
 */
import contact from '../../content/pages/contact.json';
import ContactSubmit from '../ui/ContactSubmit.astro';
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || undefined;
const { form, email, phone, next } = contact;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="get-in-touch">
  <form class="form" action={endpoint} method="post" data-fx="contact-form">
    {form.fields.map((f) => (
      <label class="field">
        <span class="t-eyebrow field-label">{f.label}</span>
        {f.type === 'textarea' ? (
          <textarea class="input textarea" name={f.name} placeholder={f.placeholder} required={f.required}></textarea>
        ) : (
          <input class="input" type={f.type} name={f.name} placeholder={f.placeholder} required={f.required} autocomplete={f.autocomplete} />
        )}
      </label>
    ))}
    <!-- Spam trap: people never see or fill it. Formspree drops posts where _gotcha is set. -->
    <input class="trap" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <ContactSubmit labels={form.submit} />
    <p class="t-body-s">{form.note}</p>
  </form>
  <div class="aside">
    {[email, phone].map((c) => (
      <a class="touch-card contact-card" href={c.href}>
        <span class="t-eyebrow">{c.label}</span>
        <span class="t-label value">{c.value}</span>
      </a>
    ))}
    <div class="touch-card next">
      <h2 class="t-label value balance">{next.title}</h2>
      <ol class="touch-rows">
        {next.steps.map((s, i) => (
          <li class="step">
            <span class="t-eyebrow touch-num">{pad(i + 1)}</span>
            <span class="t-body-s step-copy">{s}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
  .get-in-touch {
    width: 100%; max-width: var(--canvas); margin: 0 auto;
    display: flex; align-items: flex-start; gap: 80px; padding: 80px 20px 100px;
  }
  .form { position: relative; width: 600px; flex: none; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .field { width: 100%; display: flex; flex-direction: column; gap: 10px; }
  .field-label { display: block; }
  .input {
    display: block; width: 100%; height: 55px; margin: 0; padding: 12px 14px; border: 0; border-radius: 8px;
    background: var(--surface); box-shadow: inset 0 0 0 1px var(--grey-20);
    font-family: var(--font); font-size: 16px; line-height: 1.2em; font-weight: 400; color: var(--white);
    outline: none; appearance: none; -webkit-appearance: none;
    transition: box-shadow 0.2s ease;
  }
  .input::placeholder { color: var(--dark-grey); opacity: 1; }
  .input:focus, .input:focus-visible { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3); outline: none; }
  .textarea { height: auto; min-height: 100px; resize: vertical; overflow: hidden auto; }
  .trap { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; transform: scale(0); }
  .form > .t-body-s { width: 100%; }

  .aside { flex: 1 0 0; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .touch-card { width: 100%; display: flex; flex-direction: column; border-radius: 16px; background: var(--surface); overflow: clip; }
  .contact-card { gap: 10px; padding: 28px 32px; cursor: pointer; }
  .value { color: var(--white); }
  .next { gap: 20px; padding: 32px; }
  .touch-rows { list-style: none; display: flex; flex-direction: column; }
  .step { display: flex; align-items: flex-start; gap: 14px; padding: 14px 0; box-shadow: inset 0 1px 0 0 var(--grey-20); }
  .touch-num { width: 24px; flex: none; }
  .step-copy { flex: 1 0 0; min-width: 0; color: var(--grey); }

  @media (max-width: 1199.98px) {
    .get-in-touch { flex-direction: column; gap: 40px; padding: 60px 20px 100px; }
    .form { width: 100%; }
    .aside { flex: none; width: 100%; }
  }
  @media (max-width: 809.98px) {
    .get-in-touch { gap: 32px; padding: 40px 20px 64px; }
    .contact-card, .next { padding: 20px; }
  }
</style>
