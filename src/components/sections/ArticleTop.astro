---
/** Post header: category, date, title, excerpt and the cover. */
import Badge from '../blog/Badge.astro';
import PostMeta from '../blog/PostMeta.astro';
import type { Post } from '../../lib/blog';

interface Props { post: Post; }
const { post } = Astro.props;
const { data } = post;
---
<section class="article-top">
  <header class="at-header">
    <div class="at-meta">
      <Badge label={data.category} />
      <PostMeta date={data.date} readTime={data.readTime} />
    </div>
    <!-- The accordion script reads this id to drop the current post from Related reading. -->
    <h1 id="article-title" class="t-h1">{data.title}</h1>
    <p class="t-body-m">{data.excerpt}</p>
  </header>
  <img class="at-cover" src={data.cover} alt={data.coverAlt} width="1160" height="400" fetchpriority="high" />
</section>

<style>
  .article-top {
    display: flex; flex-direction: column; align-items: center; gap: 40px;
    max-width: var(--canvas); margin: 0 auto; padding: 100px 20px 0;
  }
  .at-header { display: flex; flex-direction: column; align-items: center; gap: 20px; width: 100%; }
  .at-meta { display: flex; justify-content: center; align-items: center; gap: 16px; }
  .at-header > h1, .at-header > p { width: 700px; max-width: 100%; text-align: center; }
  .at-cover { width: 100%; height: 400px; object-fit: cover; border-radius: 16px; }

  @media (max-width: 1199.98px) {
    .at-header > h1, .at-header > p { width: 100%; }
    .at-cover { height: 320px; }
  }
  @media (max-width: 809.98px) {
    .article-top { gap: 32px; padding: 64px 20px 0; }
    .at-header { gap: 16px; }
    .at-cover { height: 220px; }
  }
</style>
