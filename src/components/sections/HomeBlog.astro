---
import home from '../../content/pages/home.json';
import Button from '../ui/Button.astro';
import BlogRow from './BlogRow.astro';
import { getPosts } from '../../lib/blog';
const { blog } = home;
const posts = (await getPosts()).slice(0, 3);
---
<section class="blog">
  <div class="home-blog-title">
    <p class="t-eyebrow">{blog.eyebrow}</p>
    <h2 class="t-h2 balance">{blog.title}</h2>
    <Button href={blog.button.href}>{blog.button.label}</Button>
  </div>
  <BlogRow posts={posts} />
</section>
<style>
  .blog { width: 100%; max-width: var(--canvas); margin: 0 auto; padding: 100px 20px; overflow: clip; display: flex; flex-direction: column; align-items: center; gap: 80px; }
  .home-blog-title { width: 700px; display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; }
  .home-blog-title > p, .home-blog-title > h2 { align-self: stretch; }
  @media (max-width: 1199.98px) { .home-blog-title { width: 100%; } }
  @media (max-width: 809.98px) { .blog { padding: 64px 20px; } }
</style>
