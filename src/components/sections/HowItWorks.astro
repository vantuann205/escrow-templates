---
import home from '../../content/pages/home.json';
const { how } = home;
---
<section class="how" id="withdrawal" data-fx="step-scroll">
  <div class="how-stage">
    <div class="how-title">
      <p class="t-eyebrow">{how.eyebrow}</p>
      <h2 class="t-h2 balance">{how.title}</h2>
      <p class="t-body-m">{how.body}</p>
    </div>
    <div class="box no-phone">
      <div class="slides">
        {how.steps.map((s, i) => (
          <div class="how-card slide" data-step={i} style={i ? 'opacity:0' : undefined}>
            <img class="img" src={s.image} alt={s.imageAlt} width="1000" height="1000" loading="lazy" />
            <div class="how-body"><h3 class="t-h4">{s.title}</h3><p class="t-body-m how-desc">{s.description}</p></div>
          </div>
        ))}
      </div>
      <ol class="numbers" aria-hidden="true">
        {how.steps.map((_, i) => (
          <li class="how-num">
            <span class="t-h4 idle">{i + 1}</span>
            <span class="t-h4 active" data-step={i} style={i ? 'opacity:0' : undefined}>{i + 1}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="stacked phone-only">
      {how.steps.map((s) => (
        <div class="stacked-card">
          <div class="how-card">
            <img class="img" src={s.image} alt={s.imageAlt} width="1000" height="1000" loading="lazy" />
            <div class="how-body"><h3 class="t-h4">{s.title}</h3><p class="t-body-m how-desc">{s.description}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .how { width: 100%; max-width: var(--canvas); margin: 0 auto; height: 2900px; background: var(--page); display: flex; flex-direction: column; align-items: center; }
  .how-stage { position: sticky; top: 0; width: 100%; height: 725px; padding: 100px 20px 60px; display: flex; align-items: flex-start; gap: 56px; }
  .how-title { width: 420px; flex: none; display: flex; flex-direction: column; gap: 24px; }
  .box { flex: 1 1 0; min-width: 0; display: flex; justify-content: space-between; align-items: flex-start; padding: 32px; border-radius: 16px; background: var(--surface); overflow: clip; }
  .slides { position: relative; width: 440px; height: 501px; flex: none; }
  .slide { position: absolute; inset: 0 auto auto 0; will-change: transform, opacity; }
  .how-card { width: 440px; display: flex; flex-direction: column; gap: 20px; }
  .img { width: 100%; aspect-ratio: 1.11; height: auto; object-fit: cover; border-radius: 16px; }
  .how-body { display: flex; flex-direction: column; gap: 20px; }
  .how-desc { color: var(--dark-grey); }
  .numbers { list-style: none; width: 28px; height: 152px; display: flex; flex-direction: column; gap: 16px; }
  .how-num { position: relative; width: 28px; height: 26px; }
  .how-num > span { position: absolute; inset: 0; }
  .idle { color: var(--grey); }
  .active { color: var(--accent); }

  @media (max-width: 1199.98px) {
    .how-stage { height: 1000px; flex-direction: column; gap: 32px; }
    .how-title { width: 100%; }
    .box { width: 100%; flex: none; }
  }
  @media (max-width: 809.98px) {
    .how { height: auto; }
    .how-stage { position: relative; height: auto; padding: 64px 20px; }
    .stacked { width: 100%; display: flex; flex-direction: column; gap: 20px; }
    .stacked-card { padding: 20px; border-radius: 16px; background: var(--surface); overflow: clip; }
    .stacked-card .how-card { width: 100%; }
  }
</style>
