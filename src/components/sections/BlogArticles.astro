---
/**
 * /blog list: category tabs over a grid of post cards (every post except the
 * featured one, newest first). Filtering lives in src/scripts/fx/blog-tabs.js.
 */
import Badge from '../blog/Badge.astro';
import PostMeta from '../blog/PostMeta.astro';
import blog from '../../content/pages/blog.json';
import { postUrl, type Post } from '../../lib/blog';

interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
<section class="blog-articles" id="articles" data-fx="blog-tabs">
  <div class="ba-tabs" role="group" aria-label={blog.tabsLabel}>
    {blog.tabs.map((tab) => (
      <button type="button" class="ba-tab" data-tab={tab.value} aria-pressed={tab.value === '' ? 'true' : 'false'}>
        <span>{tab.label}</span>
      </button>
    ))}
  </div>
  <div class="ba-list">
    {posts.map((post) => (
      <a class="ba-card" href={postUrl(post)} data-category={post.data.category}>
        <div class="ba-content">
          <Badge label={post.data.category} />
          <h3 class="t-h5">{post.data.title}</h3>
          <PostMeta date={post.data.date} readTime={post.data.readTime} />
        </div>
        <div class="ba-cover">
          <img src={post.data.cover} alt={post.data.coverAlt} width="307" height="317" loading="lazy" decoding="async" />
        </div>
      </a>
    ))}
    <div class="ba-empty" data-empty hidden={posts.length > 0}>
      <p class="t-body-m">{blog.empty}</p>
    </div>
  </div>
</section>

<style>
  .blog-articles {
    display: flex; flex-direction: column; align-items: center; gap: 20px;
    max-width: var(--canvas); margin: 0 auto; padding: 0 20px 100px;
  }
  .ba-tabs { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; width: 100%; }
  .ba-tab {
    display: flex; align-items: center; justify-content: center;
    padding: 4px 12px; border-radius: 8px; overflow: clip;
    font-family: var(--font-mono); font-size: 10px; line-height: 1.2em; letter-spacing: 0.8px;
    text-transform: uppercase; white-space: nowrap; user-select: none;
    color: var(--dark-grey); background: transparent;
    transition: background-color 0.4s var(--ease-out), color 0.4s var(--ease-out);
  }
  .ba-tab[aria-pressed='true'] { background: var(--white); color: var(--black); }

  .ba-list {
    display: grid; grid-template-columns: repeat(2, minmax(280px, 1fr)); gap: 20px 8px;
    justify-content: start; width: 100%;
  }
  .ba-card {
    display: flex; align-items: center; gap: 8px; height: 317px;
    border-radius: 16px; overflow: clip; background: var(--surface);
  }
  .ba-card[hidden], .ba-empty[hidden] { display: none; }
  .ba-content {
    display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 40px;
    flex: 1 1 0; min-width: 0; padding: 32px;
  }
  .ba-content h3 { width: 100%; }
  .ba-cover { flex: none; width: 307px; height: 100%; overflow: clip; }
  .ba-cover img { width: 100%; height: 100%; object-fit: cover; }
  .ba-empty {
    grid-column: 1 / -1; display: flex; align-items: center; padding: 32px; border-radius: 16px;
    border: 1px dashed var(--surface);
  }
  .ba-empty p { color: var(--dark-grey); flex: 1; }

  @media (max-width: 1199.98px) {
    .ba-list { display: flex; flex-direction: column; gap: 20px; }
    .ba-card, .ba-empty { width: 100%; }
  }
  @media (max-width: 809.98px) {
    .blog-articles { padding: 0 20px 64px; }
    .ba-tabs {
      flex-wrap: nowrap; gap: 8px; padding-bottom: 8px;
      overflow-x: auto; overflow-y: hidden; scrollbar-width: none;
    }
    .ba-tabs::-webkit-scrollbar { display: none; }
    .ba-tab { flex: none; }
    .ba-list { gap: 16px; }
    .ba-card { flex-direction: column; align-items: flex-start; height: auto; }
    .ba-content { flex: none; width: 100%; gap: 20px; padding: 20px; }
    .ba-cover { order: -1; width: 100%; height: 180px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ba-tab { transition: none; }
  }
</style>
