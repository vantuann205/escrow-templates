---
/**
 * Pricing "Compare Plans" table. Desktop: sticky head row with all three
 * plans. Tablet/phone: a Starter/Growth/Enterprise tab bar and one plan
 * column at a time (src/scripts/fx/plan-tabs.js; Starter without JS).
 * Price cells follow the billing toggle via data-price-monthly/-annual.
 */
import page from '../../content/pages/pricing.json';
import Icon from '../ui/Icon.astro';
const { compare } = page;
type Cell = string | boolean | { monthly: string; annual: string };
---
<section class="compare" id="compare">
  <div class="compare-title">
    <p class="t-eyebrow">{compare.eyebrow}</p>
    <h2 class="t-h2 balance">{compare.title}</h2>
  </div>
  <div class="table" data-fx="plan-tabs" data-plan="starter">
    <div class="tabs-row below-desktop">
      <div class="tabs" role="group" aria-label={compare.tabsLabel}>
        {compare.columns.map((c, i) => (
          <button type="button" class="compare-tab" data-plan-tab={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="tab-pill" aria-hidden="true"></span>
            <span class="compare-tab-label t-label">{c.label}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="head-row desktop-only">
      <span class="head-backdrop" aria-hidden="true"></span>
      <p class="head-label t-eyebrow">{compare.headLabel}</p>
      {compare.columns.map((c) => <p class="head-col t-label">{c.label}</p>)}
    </div>
    {compare.groups.map((g) => (
      <div class="group">
        <div class="group-title"><p class="t-eyebrow">{g.title}</p></div>
        {g.rows.map((r) => (
          <div class="compare-row">
            <p class="compare-label t-body-m">{r.label}</p>
            {(r.cells as Cell[]).map((cell, i) => {
              const col = compare.columns[i];
              const cls = ['cell', `cell--${col.id}`];
              if (cell === true) return (
                <div class:list={[...cls, 'cell--tick']}>
                  <span class="compare-tick"><Icon name="check" size={10} /></span>
                  <span class="sr-only">{col.label}: {compare.included}</span>
                </div>
              );
              if (cell === false) return (
                <p class:list={[...cls, 'cell--none', 't-body-s']}><span aria-hidden="true">—</span><span class="sr-only">{col.label}: {compare.notIncluded}</span></p>
              );
              if (typeof cell === 'object') return (
                <p class:list={[...cls, 't-body-s']} data-price-monthly={cell.monthly} data-price-annual={cell.annual}>{cell.monthly}</p>
              );
              return <p class:list={[...cls, 't-body-s']}>{cell}</p>;
            })}
          </div>
        ))}
      </div>
    ))}
    <div class="footnote">
      <p class="t-body-s">{compare.footnote}</p>
    </div>
  </div>
</section>

<style>
  .compare {
    width: 100%; max-width: var(--canvas); margin: 0 auto;
    display: flex; flex-direction: column; align-items: center; gap: 48px; padding: 100px 20px;
  }
  .compare-title { width: 100%; display: flex; flex-direction: column; gap: 24px; }
  .compare-title h2 { max-width: 800px; }

  .table {
    width: 100%; display: flex; flex-direction: column; align-items: flex-start;
    padding: 8px 32px 32px; border-radius: var(--radius); background: var(--surface); overflow: clip;
  }

  /* Desktop head row: sticks under the 91px topbar. Its backdrop reaches
     240px up so rows scrolling past never show above it. Framer sizes it at
     105.6% of the table, so the columns sit a little right of the cells. */
  .head-row {
    position: sticky; top: 91px; z-index: 2;
    width: calc(100% + 66px); display: flex; align-items: center; gap: 20px; padding: 24px 0;
    background: rgb(28, 28, 28);
  }
  .head-row::after { content: ''; position: absolute; inset: 0; box-shadow: inset 0 -1px 0 var(--grey-20); pointer-events: none; }
  .head-backdrop { position: absolute; left: 0; right: 0; top: -240px; bottom: 0; background: rgb(28, 28, 28); }
  .head-label, .head-col { position: relative; z-index: 1; min-width: 0; }
  .head-label { flex: 2 1 0; }
  .head-col { flex: 1 1 0; color: var(--white); }

  .group { width: 100%; display: flex; flex-direction: column; }
  .group-title { padding: 34px 0 14px; }
  .compare-row {
    width: 100%; display: flex; align-items: center; gap: 20px; padding: 16px 0;
    box-shadow: inset 0 1px 0 var(--grey-20);
  }
  .compare-label { flex: 2 1 0; min-width: 0; color: var(--white); }
  .cell { flex: 1 1 0; min-width: 0; color: var(--grey); }
  .cell--growth { color: var(--white); }
  .cell--none { color: var(--dark-grey); }
  .cell--tick { display: flex; align-items: center; }
  .compare-tick {
    width: 16px; height: 16px; flex: none; display: flex; align-items: center; justify-content: center;
    border-radius: 999px; box-shadow: inset 0 0 0 1px var(--grey-20); color: var(--grey);
  }
  .cell--growth .compare-tick { color: var(--white); }
  .compare-tick :global(path) { stroke-width: 2; }

  .footnote {
    width: 100%; display: flex; align-items: center; gap: 20px; padding-top: 32px;
    box-shadow: inset 0 1px 0 var(--grey-20);
  }
  .footnote p { flex: 1 1 0; max-width: 640px; color: var(--dark-grey); }

  /* Tablet / phone plan tabs */
  .tabs-row { width: 100%; padding: 24px 0 8px; }
  .tabs {
    width: 100%; display: flex; align-items: center; gap: 4px; padding: 4px;
    border-radius: 12px; background: var(--surface); overflow: clip;
  }
  .compare-tab {
    position: relative; flex: 1 1 0; min-width: 0; height: 38px; padding: 9px 12px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center; overflow: clip;
  }
  .tab-pill { position: absolute; inset: 0; border-radius: 8px; background: var(--white); visibility: hidden; }
  .compare-tab-label { position: relative; color: var(--grey); user-select: none; white-space: nowrap; }
  .compare-tab[aria-pressed='true'] .tab-pill { visibility: visible; }
  .compare-tab[aria-pressed='true'] .compare-tab-label { color: var(--black); }

  @media (max-width: 1199.98px) {
    .table[data-plan='starter'] .cell:not(.cell--starter),
    .table[data-plan='growth'] .cell:not(.cell--growth),
    .table[data-plan='enterprise'] .cell:not(.cell--enterprise) { display: none; }
  }
  @media (max-width: 809.98px) {
    .compare { padding: 64px 20px; }
    .table { padding: 8px 20px 24px; }
    .compare-row { gap: 12px; }
    .compare-label { flex: 1 1 0; }
    .cell { text-align: center; }
    .cell--tick { justify-content: center; }
    .cell--growth .compare-tick { color: var(--grey); }
    .footnote { gap: 12px; }
  }
</style>
