---
/**
 * About page top: h1 + intro, the office photo, and the "Trusted by" row whose
 * logos drift left on a loop (Framer ticker, 12px/s) behind an edge fade.
 */
import about from '../../content/pages/about.json';
const { hero } = about;
---
<section class="about-hero">
  <div class="about-hero-title">
    <h1 class="t-h1 balance heading">{hero.title}</h1>
    <p class="t-body-m about-hero-description">{hero.description}</p>
  </div>
  <div class="about-hero-media">
    <div class="about-hero-photo">
      <img src={hero.photo.src} alt={hero.photo.alt} width={hero.photo.width} height={hero.photo.height} fetchpriority="high" />
    </div>
    <div class="trusted">
      <p class="t-eyebrow about-hero-label">{hero.trustedLabel}</p>
      <div class="logos" data-fx="logo-ticker" data-velocity="12">
        <ul class="logo-track" role="list">
          {hero.logos.map((l) => (
            <li class="logo-item">
              <div class="logo-box"><img src={l.src} alt={l.name} width="28" height="28" /></div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
<style>
  .about-hero {
    width: 100%; max-width: var(--canvas); margin: 0 auto;
    display: flex; flex-direction: column; align-items: center; gap: 80px; padding: 100px 20px;
  }
  .about-hero-title { width: 100%; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .heading, .about-hero-description { width: 100%; max-width: 800px; }
  .about-hero-media { width: 100%; display: flex; flex-direction: column; align-items: center; }
  .about-hero-photo { width: 100%; aspect-ratio: 2.36; border-radius: 16px; overflow: clip; }
  .about-hero-photo img { width: 100%; height: 100%; object-fit: cover; border-radius: 16px; }
  .trusted { width: 100%; display: flex; align-items: center; gap: 20px; padding: 20px 0; }
  .about-hero-label { width: 209px; flex: none; }
  .logos {
    flex: 1 0 0; min-width: 0; display: flex; overflow-x: clip;
    -webkit-mask-image: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 6%, rgba(0,0,0,1) 86%, rgba(0,0,0,0) 100%);
    mask-image: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 6%, rgba(0,0,0,1) 86%, rgba(0,0,0,0) 100%);
  }
  .logo-track { display: flex; align-items: center; gap: 16px; list-style: none; margin: 0; padding: 0; width: 100%; }
  .logo-item { flex: none; }
  .logo-box {
    width: 148px; height: 80px; padding: 20px; border-radius: 16px; background: var(--surface); overflow: clip;
    display: flex; align-items: center; justify-content: center;
  }
  .logo-box img { width: 28px; height: 28px; object-fit: cover; }

  @media (max-width: 809.98px) {
    .about-hero { gap: 48px; padding: 64px 20px; }
    .about-hero-photo { aspect-ratio: 1.6; }
    .trusted { flex-direction: column; align-items: flex-start; gap: 16px; }
    .about-hero-label { width: 100%; }
    .logos { flex: none; width: 100%; }
  }
</style>
