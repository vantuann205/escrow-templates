---
/**
 * Post body (the Markdown, rendered by the content collection) and the author line.
 * Markdown conventions, styled here to match the Framer article components:
 *   blockquote starting with a bold line  -> Article/Callout
 *   ordered list                          -> Article/Step rows (01, 02 ...)
 *   <figure class="figure"> HTML block    -> Article/Figure bar chart
 */
import type { Post } from '../../lib/blog';

interface Props { post: Post; }
const { post } = Astro.props;
const { author } = post.data;
---
<section class="article-body">
  <div class="prose" set:html={post.rendered?.html ?? ''} />
  <footer class="ab-author">
    <img src={author.avatar} alt={author.avatarAlt} width="32" height="32" loading="lazy" />
    <div class="ab-name">
      <p class="ab-label">{author.name}</p>
      <p class="t-eyebrow">{author.role}</p>
    </div>
  </footer>
</section>

<style>
  .article-body {
    display: flex; flex-direction: column; align-items: center; gap: 40px;
    max-width: var(--canvas); margin: 0 auto; padding: 40px 20px;
  }
  .prose, .ab-author { width: 700px; max-width: 100%; }

  /* Rich text. Framer spaces blocks with each preset's paragraph spacing,
     applied above every block but the first; components take none. */
  .prose { display: flex; flex-direction: column; }
  .prose > :global(*) { margin: 0; }
  .prose :global(p) { font-size: 16px; line-height: 1.2em; color: var(--grey); }
  .prose > :global(p), .prose > :global(ul), .prose > :global(h3) { margin-top: 20px; }
  .prose > :global(h2), .prose > :global(h4), .prose > :global(h5) { margin-top: 40px; }
  .prose > :global(:first-child) { margin-top: 0; }
  .prose :global(h2), .prose :global(h3), .prose :global(h4), .prose :global(h5) { font-weight: 400; line-height: 1.1em; color: var(--white); }
  .prose :global(h2) { font-size: 48px; }
  .prose :global(h3) { font-size: 32px; }
  .prose :global(h4) { font-size: 24px; }
  .prose :global(h5) { font-size: 20px; line-height: 1.2em; }
  .prose :global(strong) { font-weight: 600; color: var(--white); }
  .prose :global(a) { color: var(--white); text-decoration: underline; text-underline-offset: 2px; }
  .prose > :global(ul) { padding-left: 20px; font-size: 16px; line-height: 1.2em; color: var(--grey); }

  /* Article/Callout: > **Title** then the body. */
  .prose > :global(blockquote) {
    display: flex; flex-direction: column; gap: 20px;
    margin: 20px 0; padding: 32px; border-radius: 16px; background: var(--surface);
  }
  .prose > :global(blockquote) :global(p) { margin: 0; }
  .prose > :global(blockquote > p:first-child) { line-height: 1.1em; color: var(--white); }
  .prose > :global(blockquote > p:first-child strong) { font-weight: 400; }

  /* Article/Step: an ordered list, numbered 01, 02 ... */
  .prose > :global(ol) { list-style: none; counter-reset: step; }
  .prose > :global(ol) :global(li) {
    counter-increment: step;
    display: flex; align-items: flex-start; gap: 16px; padding: 17px 0;
    font-size: 16px; line-height: 1.2em; color: var(--grey);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .prose > :global(ol) :global(li::before) {
    content: counter(step, decimal-leading-zero);
    flex: none; width: 34px;
    font-family: var(--font-mono); font-size: 14px; line-height: 1.2em; color: var(--dark-grey);
  }
  .prose > :global(ol) :global(li:first-child) { padding-top: 37px; }
  .prose > :global(ol) :global(li:last-child) {
    padding-bottom: 37px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), inset 0 -1px 0 rgba(255, 255, 255, 0.08);
  }

  /* Article/Figure: horizontal bar chart. Each row sets --bar, its width as
     a share of the largest value. */
  .prose > :global(figure.figure) {
    display: flex; flex-direction: column;
    margin: 20px 0; padding: 34px 36px 28px; border-radius: 16px; overflow: clip;
    background: var(--surface);
  }
  .prose :global(.figure p) { margin: 0; }
  .prose :global(.figure figcaption) { display: flex; flex-direction: column; gap: 8px; }
  .prose :global(.figure-title) { line-height: 1.1em; color: var(--white); }
  .prose :global(.figure-subtitle), .prose :global(.figure-axis p), .prose :global(.figure-row p:nth-child(n + 2)) {
    font-family: var(--font-mono); font-size: 14px; line-height: 1.2em; color: var(--dark-grey);
  }
  .prose :global(.figure-rows) { display: flex; flex-direction: column; gap: 16px; padding: 30px 0 20px; }
  /* Label over track on the left; percent over count on the right, the pair
     centred on the row (the margins stack them inside one grid cell). */
  .prose :global(.figure-row) { display: grid; grid-template-columns: minmax(0, 1fr) 66px; grid-template-rows: auto auto; column-gap: 18px; }
  .prose :global(.figure-row p:nth-child(1)) { grid-area: 1 / 1; }
  .prose :global(.figure-row p:nth-child(n + 2)) { grid-area: 1 / 2 / 3 / 3; align-self: center; text-align: right; }
  .prose :global(.figure-row p:nth-child(2)) { margin-bottom: calc(1.2em + 5px); color: var(--white); }
  .prose :global(.figure-row p:nth-child(3)) { margin-top: calc(1.2em + 5px); }
  .prose :global(.figure-row::before), .prose :global(.figure-row::after) {
    content: ''; grid-area: 2 / 1; height: 12px; margin-top: 9px; border-radius: 0 4px 4px 0;
  }
  .prose :global(.figure-row::before) { background: var(--surface); }
  .prose :global(.figure-row::after) { width: var(--bar, 0%); max-width: 100%; background: var(--grey-20); }
  .prose :global(.figure-row.is-outline p:nth-child(1)) { color: var(--white); }
  .prose :global(.figure-row.is-outline::after) { background: none; border: 1px dashed rgba(255, 255, 255, 0.35); }
  .prose :global(.figure-axis) {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 84px 20px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08); border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .prose :global(.figure .figure-caption) { margin-top: 18px; font-size: 14px; line-height: 1.2em; color: var(--dark-grey); }

  /* Author */
  .ab-author {
    display: flex; align-items: flex-start; gap: 16px; padding: 20px 0;
    box-shadow: inset 0 1px 0 var(--grey-20);
  }
  .ab-author img { flex: none; width: 32px; height: 32px; border-radius: 999px; object-fit: cover; }
  .ab-name { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
  .ab-label { font-size: 16px; line-height: 1.1em; color: var(--grey); }

  @media (max-width: 1199.98px) {
    .prose, .ab-author { width: 100%; }
    .prose :global(h2) { font-size: 40px; }
  }
  @media (max-width: 809.98px) {
    .article-body { gap: 32px; padding: 32px 20px; }
    .prose :global(h2) { font-size: 28px; }
    .prose :global(h4) { font-size: 20px; }
  }
</style>
