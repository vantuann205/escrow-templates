---
/** Category pill. "surface" sits on dark cards, "white" on photos. */
interface Props { label: string; variant?: 'surface' | 'white'; class?: string; }
const { label, variant = 'surface', class: cls } = Astro.props;
---
<span class:list={['badge', `badge--${variant}`, cls]}><span>{label}</span></span>
<style>
  .badge {
    display: inline-flex; align-items: center; flex: none;
    padding: 4px 11px; border-radius: 8px; overflow: clip;
    font-family: var(--font-mono); font-size: 10px; line-height: 1.2em; letter-spacing: 0.8px;
    text-transform: uppercase; white-space: nowrap; user-select: none;
  }
  .badge--surface { background: var(--surface); color: var(--grey); }
  .badge--white { background: var(--white); color: var(--black); }
</style>
