---
/** Date * read time, the eyebrow line under every post title. */
import blog from '../../content/pages/blog.json';
import { formatDate } from '../../lib/blog';
interface Props { date: Date; readTime: string; /** light = grey text, for cards on a photo */ tone?: 'dark' | 'light'; class?: string; }
const { date, readTime, tone = 'dark', class: cls } = Astro.props;
---
<p class:list={['post-meta t-eyebrow', tone === 'light' && 'post-meta--light', cls]}>
  <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
  <span aria-hidden="true">{blog.metaSeparator}</span>
  <span>{readTime}</span>
</p>
<style>
  .post-meta { display: flex; align-items: center; gap: 6px; white-space: nowrap; }
  .post-meta > * { flex: none; }
  .post-meta--light { color: var(--grey); }
</style>
